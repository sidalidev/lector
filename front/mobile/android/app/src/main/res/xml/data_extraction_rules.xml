<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone: no cloud backup and no device-to-device transfer.
  allowBackup="false" does not stop device transfer on Android 12 and later: only these rules do.
  This covers the sync chain keys and proof (IndexedDB lector-chaine), the personal API keys
  (lector-keys) and every other local file. A new phone joins the chain with its 12 words.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="device_root" />
        <exclude domain="device_file" />
        <exclude domain="device_database" />
        <exclude domain="device_sharedpref" />
    </device-transfer>
</data-extraction-rules>
