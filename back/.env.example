# SQLite database (production: file:/data/lector.db)
DATABASE_URL="file:./dev.db"
PORT=3456

# Encrypted blocks of each chain (production: /data/chain)
CHAIN_FILES_ROOT="./dev-chain"

# Limits per chain: total bytes, plaintext bytes per document, documents
CHAIN_QUOTA_BYTES=20971520
CHAIN_MAX_DOC_BYTES=524288
CHAIN_MAX_DOCS=5000
# A chain with no request for this many days is deleted by the daily purge
CHAIN_INACTIVE_DAYS=180

# Server wide: maximum number of chains, chain creations per IP and per hour
CHAIN_MAX_CHAINS=10000
CHAIN_CREATE_PER_HOUR=5
# Anti-sharing: distinct networks (IPv4 /24, IPv6 /48) allowed to read one
# chain over a sliding 24 hours; reads from a new network beyond that get 429.
# Counted in memory only, as salted hashes rotated every 24 hours.
CHAIN_READ_NETWORKS_MAX=8
# "off" disables the per IP and per network limits (tests only)
CHAIN_RATE_LIMITS=on

# Token to announce a desktop release to running apps, POST /v1/releases/notify (openssl rand -hex 32)
RELEASE_NOTIFY_TOKEN=""
