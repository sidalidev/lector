datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Un casier par chaîne. Aucun compte : le casier n'est connu que par l'id
// public de la chaîne et l'empreinte de la preuve.
model Chain {
  id         String     @id // 32 hex, dérivé de S côté client
  proofHash  String // hex(SHA-256(P)), jamais la preuve elle-même
  bytesUsed  Int        @default(0) // somme des size des blocs vivants
  docCount   Int        @default(0) // blocs vivants
  createdAt  DateTime   @default(now())
  lastSeenAt DateTime   @default(now()) // écrit au plus une fois par heure
  docs       ChainDoc[]
}

// Bloc chiffré d'un document. Le serveur ne voit ni le chemin ni le contenu :
// docId est un HMAC du chemin, pathEnc et le bloc sont chiffrés côté client.
model ChainDoc {
  id        String    @id @default(uuid())
  chainId   String
  chain     Chain     @relation(fields: [chainId], references: [id], onDelete: Cascade)
  docId     String // 64 hex
  pathEnc   String
  sha256    String // '' pour une pierre tombale
  size      Int // 0 pour une pierre tombale
  mtime     DateTime
  deletedAt DateTime?
  tombEnc   String?
  updatedAt DateTime  @updatedAt

  @@unique([chainId, docId])
  @@index([chainId, deletedAt])
}

// Salon de co-écriture (docs/collab-design.md § 6). Le relais ne connaît que
// l'id (dérivé de la clé du document, sans retour possible), l'empreinte de la
// preuve et celle du secret du propriétaire. Aucun compte, aucun nom.
model CollabRoom {
  id         String        @id // 32 hex
  proofHash  String // hex(SHA-256(P))
  ownerHash  String // hex(SHA-256(O)), seul le propriétaire peut arrêter
  lastSeq    Int           @default(0)
  baseSeq    Int           @default(0) // numéro de l'instantané compacté, 0 sans instantané
  bytesUsed  Int           @default(0)
  createdAt  DateTime      @default(now())
  lastSeenAt DateTime      @default(now()) // écrit au plus une fois par heure
  entries    CollabEntry[]
}

// Message chiffré d'un salon : mise à jour ou instantané (seq = baseSeq).
model CollabEntry {
  roomId String
  room   CollabRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  seq    Int
  data   Bytes // enveloppe AES-GCM, illisible pour le relais

  @@id([roomId, seq])
}

// Salon arrêté ou purgé : son id répond comme inexistant et ne peut pas être recréé.
model CollabRoomGone {
  id     String   @id
  goneAt DateTime @default(now())
}
