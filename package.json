{
  "name": "lector",
  "version": "2.2.0",
  "description": "Markdown editor: plain notes, beautifully rendered, edited in real time, synced end to end encrypted",
  "license": "MIT",
  "main": "front/desktop/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "cd front && vite",
    "build": "cd front && vite build",
    "electron": "electron .",
    "start": "concurrently \"npm:dev\" \"wait-on http://localhost:5173 && LECTOR_APP_URL=http://localhost:5173/ electron .\"",
    "dist": "electron-builder --mac",
    "deploy": "bash deploy/deploy.sh",
    "cap:ios": "npm run build && cd front && npx cap sync ios",
    "cap:android": "npm run build && cd front && npx cap sync android",
    "test": "npx playwright test --config e2e/playwright.config.js --grep-invert electron",
    "test:ui": "npx playwright test --ui --config e2e/playwright.config.js",
    "test:api": "npx playwright test --project=api --config e2e/playwright.config.js",
    "test:flows": "npx playwright test --project=flows --config e2e/playwright.config.js --grep-invert electron",
    "test:poids": "npm run build && node --test e2e/poids/poids.test.mjs",
    "test:chaine": "node --test front/src/services/chaine/*.test.mjs front/src/services/collab/*.test.mjs front/src/services/taches/*.test.mjs front/src/components/editor/livePreview/*.test.mjs front/src/utils/*.test.mjs front/desktop/*.test.cjs"
  },
  "author": {
    "name": "Sid",
    "email": "contact@sidali.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sidalidev/Lector.git"
  },
  "build": {
    "appId": "com.lector.app",
    "productName": "Lector",
    "publish": {
      "provider": "generic",
      "url": "https://lector.sidali.dev/releases"
    },
    "afterSign": "front/desktop/build/notarize.js",
    "mac": {
      "category": "public.app-category.productivity",
      "identity": "Sid Bentifraouine (AFZ3KWB56Q)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "front/desktop/build/entitlements.mac.plist",
      "entitlementsInherit": "front/desktop/build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "front/desktop/build/icon.icns"
    },
    "files": [
      "front/desktop/*.js",
      "!front/desktop/*.test.cjs",
      "front/desktop/hors-ligne.html",
      "front/public/icon-512.png",
      "front/desktop/vault/**/*",
      "front/src/services/chaine/*.js",
      "!front/src/services/chaine/*.test.mjs",
      "front/src/services/chaine/package.json",
      "!node_modules",
      "node_modules/chokidar/**/*",
      "node_modules/readdirp/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/argparse/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/sax/**/*",
      "node_modules/tiny-typed-emitter/**/*"
    ],
    "asarUnpack": [
      "front/public/icon-512.png"
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@codemirror/commands": "^6.10.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.1",
    "@codemirror/state": "^6.5.4",
    "@codemirror/view": "^6.39.14",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-naskh-arabic": "^5.3.0",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.7.3",
    "lucide-react": "^0.562.0",
    "preact": "10.29.8",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "concurrently": "^9.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "vite": "^7.3.1",
    "wait-on": "^9.0.3"
  }
}
